# ===========================================================================
#  NeoBot configuration — TEMPLATE
# ===========================================================================
#
#  Copy this file to `.env` and fill in the three required values:
#
#      cp .env.example .env        (macOS/Linux)
#      copy .env.example .env      (Windows cmd)
#      Copy-Item .env.example .env (PowerShell)
#
#  `.env` is gitignored and must never be committed. This file is the only
#  one of the pair that belongs in the repository — keep it free of real
#  tokens, ids and keys.
#
#  Check your setup at any time without starting the bot:
#
#      npm run doctor
#
#  Most values below are DEFAULTS a server can override at runtime with
#  /config. Where that is true it is noted, and the per-server choice wins.
# ===========================================================================


# ---------------------------------------------------------------------------
#  REQUIRED — the bot will not start without these
# ---------------------------------------------------------------------------

# Bot token. Developer Portal -> your application -> Bot -> Reset Token.
#
#   https://discord.com/developers/applications
#
# This is NOT the Client Secret and NOT the Public Key. Discord shows it once;
# resetting invalidates the previous one. Treat it like a password — anyone
# holding it controls the bot. If it ever leaks, reset it immediately.
DISCORD_TOKEN=

# Application ID. Developer Portal -> your application -> General Information.
# A public identifier (it appears in invite links), unlike the token.
DISCORD_CLIENT_ID=

# The server to register slash commands into while developing. Guild commands
# appear instantly; global ones can take up to an hour.
#
# To find it: Discord Settings -> Advanced -> enable Developer Mode, then
# right-click the server icon -> Copy Server ID.
#
# Leave this EMPTY only if you deploy globally with `npm run deploy:global`.
DISCORD_GUILD_ID=


# ---------------------------------------------------------------------------
#  BEFORE FIRST RUN — two things that are not in this file
# ---------------------------------------------------------------------------
#
#  1. Developer Portal -> Bot -> Privileged Gateway Intents:
#       - Server Members Intent    ON   (moderation needs it)
#       - Message Content Intent   ON   (/tts-join reads chat aloud)
#     Without Message Content, message text arrives EMPTY rather than
#     erroring, so TTS silently never speaks.
#
#  2. Developer Portal -> Bot -> "Requires OAuth2 Code Grant": OFF.
#     Leaving it on makes every invite fail at the final step with
#     "Integration requires code grant", and the bot joins nothing.
#
#  Then invite the bot with `npm run invite` — that URL carries both the
#  `bot` and `applications.commands` scopes. A bot-only invite joins fine but
#  cannot register slash commands.
#
#  `npm run doctor` verifies all of the above.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
#  GAME DEALS — optional
# ---------------------------------------------------------------------------

# Free IsThereAnyDeal API key. Without one, /deals still works but returns
# Steam-only results instead of comparing Epic, GOG, Humble, Fanatical etc.
#
#   https://isthereanydeal.com/apps/my/   (create an app, copy the key)
#
# Per-server override: /config. Prefer setting it there — /config collects it
# through a private modal, whereas this file is one more place a key lives.
ITAD_API_KEY=

# Two-letter country code for pricing and currency on both /deals and /steam.
# Per-server override: /config
PRICE_COUNTRY=US


# ---------------------------------------------------------------------------
#  TEXT TO SPEECH — optional, sensible defaults
# ---------------------------------------------------------------------------

# Default speaking voice for /tts-join. Any Microsoft Edge voice ShortName.
#   Vietnamese : vi-VN-HoaiMyNeural (F), vi-VN-NamMinhNeural (M)
#   English    : en-US-AriaNeural (F), en-US-GuyNeural (M)
#   Full list  : https://learn.microsoft.com/azure/ai-services/speech-service/language-support
#
# Per-server override: /tts-voice set  (autocompletes over the live catalogue)
TTS_VOICE=vi-VN-HoaiMyNeural

# Spoken messages longer than this are truncated. 50-1000.
# Per-server override: /config
TTS_MAX_MESSAGE_LENGTH=300

# How many lines may queue before the oldest is dropped. 1-20.
# Per-server override: /config
TTS_MAX_QUEUE_LENGTH=5

# Prefix each spoken line with "<name> says:". true or false.
# Per-server override: /config
TTS_ANNOUNCE_AUTHOR=true


# ---------------------------------------------------------------------------
#  ERROR REPORTING — optional, strongly recommended once hosted
# ---------------------------------------------------------------------------

# Channel id where runtime errors are mirrored, with a stack trace and the
# user/guild/channel involved. Nobody reads stdout on a hosted bot, so without
# this a command that started failing yesterday goes unnoticed.
#
# Right-click a channel -> Copy Channel ID (needs Developer Mode).
#
# This is the FALLBACK, used for process-level errors that belong to no
# server. Per-server channels are set by running /config inside the channel
# you want and choosing "Error log channel".
ERROR_LOG_CHANNEL_ID=

# Your Discord user id. Pinged on error reports when set.
# Right-click your own name -> Copy User ID.
OWNER_ID=


# ---------------------------------------------------------------------------
#  RUNTIME — optional
# ---------------------------------------------------------------------------

# Where the SQLite database lives (infractions and per-server settings).
#
# IMPORTANT ON HOSTED PLATFORMS: container filesystems are wiped on every
# redeploy. On Railway, mount a volume and point this at it:
#
#     DATABASE_PATH=/data/neobot.sqlite
#
# Without that, every warning and every /config setting is lost on each deploy.
DATABASE_PATH=./data/neobot.sqlite

# error | warn | info | debug
#
# `info` logs one line per action the bot takes — every command with its
# arguments, every component interaction, voice joins, and each message read
# aloud (by length only).
#
# `debug` adds the things deliberately kept out of a normal log: the TEXT of
# messages spoken, autocomplete traffic, and ffmpeg output. Useful while
# diagnosing, but it means the log accumulates what people said in voice chat —
# so turn it back down afterwards.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
#  NOT SET HERE: two variables for LINUX DEPLOYMENTS only
# ---------------------------------------------------------------------------
#
#  On Linux, youtube-dl-exec downloads yt-dlp as a Python zipapp that needs a
#  system python3 at runtime. To avoid that, tell it to fetch the standalone
#  build instead by setting these on the HOSTING PLATFORM (Railway: Service ->
#  Variables), not in this file:
#
#      YOUTUBE_DL_SKIP_PYTHON_CHECK=1
#      YOUTUBE_DL_FILENAME=yt-dlp_linux
#
#  Deliberately NOT listed as variables above, for two reasons:
#
#    * They would BREAK local development on Windows and macOS, where the
#      downloaded binary is already self-contained and has a different name.
#    * They are read by the youtube-dl-exec package, not by src/lib/config.js.
#      A test asserts everything in this file is actually read by the app, so
#      adding them here would fail the suite.
#
#  Both are needed at build AND runtime, because the package resolves the
#  binary's path from them when it starts. Platform variables cover both;
#  nixpacks.toml [variables] do not reach the runtime environment.
